{
  "uid": "signalbridge-pipeline",
  "title": "SignalBridge | Detection pipeline health",
  "description": "Prepared operational dashboard. Native scrape, alerts and rendering must be verified in the approved isolated lab; no production or reliability acceptance is implied.",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "timezone": "utc",
  "refresh": "15s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "tags": [
    "signalbridge",
    "lab-operations",
    "native-verification-pending"
  ],
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "links": [],
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "What this dashboard establishes",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 4
      },
      "options": {
        "mode": "markdown",
        "content": "Operational observations from SignalBridge's protected exporter. **This dashboard is prepared; native Prometheus/Grafana execution remains unverified.**\n\n`app1`\u2013`app8` map to the operator's fixed application order. Worker slots describe a shared pool. Database counts are retained gauges, not monotonic counters. Missing samples mean unavailable evidence. Local SOC export does not establish native Wazuh delivery. No external notifications or autonomous response."
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Exporter scrape success",
      "description": "Prometheus's own actual scrape result; no synthetic fallback for absent data.",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "signalbridge-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"signalbridge\"}",
          "range": false,
          "instant": true,
          "format": "time_series",
          "legendFormat": "{{scope}} {{slot}} {{state}} {{stage}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "No evidence",
          "min": 0
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 3,
      "type": "table",
      "title": "Configured worker pulse states",
      "description": "Recent, stale, missing or clock_error by primary/secondary slot. A pulse does not establish completed detection.",
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "signalbridge-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "signalbridge_worker_state{job=\"signalbridge\"} == 1",
          "range": false,
          "instant": true,
          "format": "table",
          "legendFormat": "{{scope}} {{slot}} {{state}} {{stage}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "No evidence",
          "min": 0
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Pending records",
      "description": "Accepted logical records still pending, including scheduled retries.",
      "gridPos": {
        "x": 0,
        "y": 11,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "signalbridge-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "signalbridge_retained_events{job=\"signalbridge\",state=\"pending\"}",
          "range": true,
          "instant": false,
          "format": "time_series",
          "legendFormat": "{{scope}} {{slot}} {{state}} {{stage}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No evidence",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Oldest pending record age",
      "description": "Absent for an empty queue; do not interpret no data as zero delay.",
      "gridPos": {
        "x": 12,
        "y": 11,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "signalbridge-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "time() - signalbridge_queue_oldest_received_timestamp_seconds{job=\"signalbridge\"}",
          "range": true,
          "instant": false,
          "format": "time_series",
          "legendFormat": "{{scope}} {{slot}} {{state}} {{stage}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "No evidence",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      }
    },
    {
