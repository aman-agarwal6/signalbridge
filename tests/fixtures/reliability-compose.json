          "target": "/signalbridge/input/documents/observation",
          "read_only": true,
          "bind": {}
        },
        {
          "type": "bind",
          "source": "/reference-proof-profile/wazuh/idle/documents/detection",
          "target": "/signalbridge/input/documents/detection",
          "read_only": true,
          "bind": {}
        },
        {
          "type": "bind",
          "source": "/reference-proof-profile/evidence/soc-delivery/enterprise/expenses/observation/24856317-a79f-5a27-932c-522a6c9e04d0",
          "target": "/signalbridge/input/expenses/observation",
          "read_only": true,
