      ],
      "shm_size": "16777216",
      "user": "0:0",
      "volumes": [
        {
          "type": "bind",
          "source": "/reference-proof-profile/source",
          "target": "/workspace",
          "read_only": true,
          "bind": {}
        },
        {
          "type": "bind",
