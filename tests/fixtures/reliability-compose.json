        },
        {
          "type": "bind",
          "source": "/reference-proof-profile/wazuh/idle/expenses/detection",
          "target": "/signalbridge/input/expenses/detection",
          "read_only": true,
          "bind": {}
        }
      ],
      "working_dir": "/workspace"
    }
  },
  "volumes": {
