// SignalBridge R1 (rolling-v2), hand-written: Sigma's Kusto backend cannot compile correlations.
// One account fails to read three or more distinct private records (denied or not visible)
// within an inclusive five-minute window, per app, environment and source.
let failed = SignalBridgeAccess_CL
    | where operation == "private_record.read" and outcome in ("denied", "not_visible");
failed
| project app, environment, source, actor, window_end = TimeGenerated
| join kind=inner (failed | project app, environment, source, actor, TimeGenerated, resource)
    on app, environment, source, actor
| where TimeGenerated between ((window_end - 5m) .. window_end)
| summarize resources = make_set(resource) by app, environment, source, actor, window_end
| where array_length(resources) >= 3
